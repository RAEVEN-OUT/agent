# Copy to ../.env (the project's parent folder) and fill in.
# Never commit the real .env.

# --- WhatsApp Cloud API ---
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_APP_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=make_up_any_random_string
WHATSAPP_API_VERSION=v24.0

# Set false ONLY for local curl testing without real Meta signatures.
VERIFY_WEBHOOK_SIGNATURE=true

# --- Gemini ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSIONS=1536

# --- Firebase (admin panel, Phase 3) ---
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_CREDENTIALS_PATH=./firebase-service-account.json

# --- Razorpay (Phase 2) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Infra (docker-compose overrides these automatically) ---
POSTGRES_USER=aiemployee
POSTGRES_PASSWORD=aiemployee
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=aiemployee
REDIS_URL=redis://localhost:6379/0
QDRANT_HOST=localhost
QDRANT_PORT=6333

# --- Behaviour ---
ENV=dev
LOG_LEVEL=INFO
AUTO_CREATE_TABLES=true
FTS_FAST_PATH_RANK=0.30
SEMANTIC_MIN_SCORE=0.55
