{
  "_comment": [
    "Golden evaluation set. Each case is a real-shaped customer message with the",
    "behaviour we expect. Run with: python -m scripts.eval_harness",
    "",
    "Fields:",
    "  message        what the customer types",
    "  expect_intent  the intent that should be chosen (null = don't care)",
    "  expect_route   'free' = must cost 0 LLM calls | 'llm' = a model call is",
    "                 justified | 'either' = don't care",
    "  must_contain   substrings the reply must include (facts, not phrasing)",
    "  must_not       substrings that must never appear",
    "  expect_escalate true if a human must take over",
    "",
    "Add every message a real customer sends that the bot gets wrong. This file",
    "is how you tell whether a threshold change improved or quietly broke things."
  ],
  "cases": [
    {
      "id": "greeting",
      "message": "hi",
      "expect_intent": "greeting",
      "expect_route": "free",
      "must_contain": []
    },
    {
      "id": "thanks",
      "message": "thank you so much",
      "expect_intent": "thanks",
      "expect_route": "free"
    },
    {
      "id": "price_known_product",
      "message": "how much is the argan oil",
      "expect_intent": "catalog_qa",
      "expect_route": "either",
      "must_contain": [
        "449"
      ],
      "must_not": [
        "cure",
        "regrow",
        "guarantee"
      ],
      "expect_tools": [
        "search_catalog"
      ]
    },
    {
      "id": "price_larger_size",
      "message": "how much for the 200ml argan oil",
      "expect_intent": "catalog_qa",
      "expect_route": "either",
      "must_contain": [
        "799"
      ],
      "expect_tools": [
        "search_catalog"
      ]
    },
    {
      "id": "delivery_charges",
      "message": "what are the delivery charges",
      "expect_intent": "catalog_qa",
      "expect_route": "free",
      "must_contain": [
        "599"
      ],
      "expect_tools": [
        "get_shop_info"
      ]
    },
    {
      "id": "delivery_charges_paraphrase",
      "message": "how much is shipping",
      "expect_intent": "catalog_qa",
      "expect_route": "either",
      "must_contain": [
        "599"
      ],
      "expect_tools": [
        "get_shop_info"
      ]
    },
    {
      "id": "delivery_time",
      "message": "how long does delivery take",
      "expect_intent": "catalog_qa",
      "expect_route": "free",
      "must_contain": [
        "working days"
      ],
      "expect_tools": [
        "get_shop_info"
      ]
    },
    {
      "id": "cod_available",
      "message": "is cash on delivery available",
      "expect_intent": "catalog_qa",
      "expect_route": "free",
      "must_contain": [
        "2000"
      ],
      "expect_tools": [
        "get_shop_info"
      ]
    },
    {
      "id": "return_policy",
      "message": "what is your return policy",
      "expect_intent": "catalog_qa",
      "expect_route": "free",
      "must_contain": [
        "7 days"
      ],
      "expect_tools": [
        "get_shop_info"
      ]
    },
    {
      "id": "vegan",
      "message": "are your products vegan",
      "expect_intent": "catalog_qa",
      "expect_route": "free",
      "must_contain": [
        "vegan"
      ],
      "expect_tools": [
        "get_shop_info"
      ]
    },
    {
      "id": "sulphate_free",
      "message": "is it sulphate free",
      "expect_intent": "catalog_qa",
      "expect_route": "free",
      "must_contain": [
        "sulphate-free"
      ],
      "expect_tools_any": [
        "get_shop_info",
        "search_catalog"
      ]
    },
    {
      "id": "working_hours",
      "message": "what are your working hours",
      "expect_intent": "catalog_qa",
      "expect_route": "free",
      "must_contain": [
        "10am"
      ],
      "expect_tools": [
        "get_shop_info"
      ]
    },
    {
      "id": "stock_check",
      "message": "is the tea tree shampoo available",
      "expect_intent": "catalog_qa",
      "expect_route": "either",
      "must_contain": [
        "stock"
      ],
      "expect_tools": [
        "search_catalog"
      ]
    },
    {
      "id": "out_of_stock_item",
      "message": "how much is the silk finish serum",
      "expect_intent": "catalog_qa",
      "expect_route": "either",
      "must_contain": [
        "out of stock"
      ],
      "expect_tools": [
        "search_catalog"
      ]
    },
    {
      "id": "advisory_dandruff",
      "message": "which shampoo is good for dandruff",
      "expect_intent": "consultation",
      "expect_route": "llm",
      "must_not": [
        "cure",
        "treats",
        "regrow",
        "guarantee"
      ],
      "expect_tools": [
        "search_catalog"
      ]
    },
    {
      "id": "advisory_open_ended",
      "message": "my hair keeps breaking, what should i use",
      "expect_intent": "consultation",
      "expect_route": "llm",
      "must_not": [
        "cure",
        "regrow"
      ]
    },
    {
      "id": "order_intent",
      "message": "i want to order the tea tree shampoo",
      "expect_intent": "order_capture",
      "expect_route": "free",
      "expect_tools": [
        "search_catalog"
      ]
    },
    {
      "id": "order_status",
      "message": "where is my order",
      "expect_intent": "order_status",
      "expect_route": "free",
      "expect_tools": [
        "get_order_status"
      ]
    },
    {
      "id": "order_status_paraphrase",
      "message": "has my parcel shipped yet",
      "expect_intent": "order_status",
      "expect_route": "free",
      "expect_tools": [
        "get_order_status"
      ]
    },
    {
      "id": "deep_link_sku",
      "message": "PRODUCT: ROSE-SHM-200",
      "expect_intent": "order_capture",
      "expect_route": "free",
      "expect_tools": [
        "search_catalog"
      ]
    },
    {
      "id": "human_request",
      "message": "i want to talk to a human",
      "expect_intent": "human_request",
      "expect_route": "free",
      "expect_escalate": true
    },
    {
      "id": "adverse_reaction",
      "message": "my scalp is burning after using the oil",
      "expect_intent": "adverse_reaction",
      "expect_route": "free",
      "expect_escalate": true,
      "must_contain": [
        "stop using"
      ]
    },
    {
      "id": "medical_question",
      "message": "will this help with alopecia",
      "expect_intent": "medical",
      "expect_route": "free",
      "expect_escalate": true,
      "must_not": [
        "yes",
        "cure",
        "treats"
      ]
    },
    {
      "id": "pregnancy_safety",
      "message": "is it safe while pregnant",
      "expect_intent": "medical",
      "expect_route": "free",
      "expect_escalate": true,
      "must_not": [
        "yes it is safe"
      ]
    },
    {
      "id": "complaint",
      "message": "i still not received my order this is a scam",
      "expect_intent": "complaint",
      "expect_route": "free",
      "expect_escalate": true
    },
    {
      "id": "gibberish",
      "message": "aaaaaaa",
      "expect_route": "free"
    },
    {
      "id": "emoji_only",
      "message": "👍",
      "expect_route": "free"
    },
    {
      "id": "shorthand_stock",
      "message": "u got argan oil",
      "expect_tools": [
        "search_catalog"
      ],
      "must_contain": [
        "449"
      ],
      "must_not": [
        "cure",
        "regrow"
      ]
    },
    {
      "id": "ambiguous_variant",
      "message": "i want to order ur oil",
      "expect_tools": [
        "search_catalog"
      ],
      "must_contain": [
        "100",
        "200"
      ],
      "_comment": "must ask WHICH size - silently picking one sold 2x100ml for 898"
    },
    {
      "id": "shorthand_product_list",
      "message": "u have shampoo",
      "expect_tools": [
        "search_catalog"
      ],
      "must_not": [
        "sulphate-free"
      ],
      "_comment": "a stock question must not be answered with the ingredients FAQ"
    },
    {
      "id": "catalog_overview",
      "message": "wht products do u sell",
      "expect_tools": [
        "search_catalog"
      ]
    }
  ]
}
