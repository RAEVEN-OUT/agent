# Copy to ../.env (the project's parent folder) and fill in.
# Never commit the real .env.

# --- WhatsApp Cloud API ---
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_APP_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=make_up_any_random_string
WHATSAPP_API_VERSION=v24.0

# Set false ONLY for local curl testing without real Meta signatures.
VERIFY_WEBHOOK_SIGNATURE=true

# --- Gemini ---
# Price per 1M tokens (in/out), 2026-07. Output price INCLUDES thinking tokens.
#   gemini-2.5-flash-lite  $0.10 / $0.40   <- default; cheapest current model
#   gemini-3.1-flash-lite  $0.25 / $1.50
#   gemini-2.5-flash       $0.30 / $2.50
#   gemini-3.6-flash       $1.50 / $7.50   <- 15x the input cost of flash-lite
# Do NOT use gemini-2.0-flash: deprecated, shut down 2026-06-01.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_ROUTER_MODEL=gemini-2.5-flash-lite
GEMINI_DISABLE_THINKING=true
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSIONS=1536

# --- Firebase (admin panel, Phase 3) ---
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_CREDENTIALS_PATH=./firebase-service-account.json

# --- Razorpay (Phase 2) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Infra (docker-compose overrides these automatically) ---
POSTGRES_USER=aiemployee
POSTGRES_PASSWORD=aiemployee
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=aiemployee
REDIS_URL=redis://localhost:6379/0
QDRANT_HOST=localhost
QDRANT_PORT=6333

# --- Behaviour ---
ENV=dev
LOG_LEVEL=INFO
AUTO_CREATE_TABLES=true
# ts_rank returns small values (~0.061 for one matching term). Too high and the
# free fast path never fires. Calibrate with: python -m scripts.tune_retrieval
FTS_FAST_PATH_RANK=0.05
SEMANTIC_MIN_SCORE=0.55


docker compose exec api python -m scripts.tune_retrieval        # calibrate threshold
docker compose exec api python -m scripts.eval_harness --delay 13